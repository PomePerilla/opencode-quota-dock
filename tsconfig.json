{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "jsx": "preserve", "jsxImportSource": "solid-js", "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["node"], "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests", "preview", "*.config.ts"],
  "exclude": ["node_modules", "dist", "artifacts"]
}
